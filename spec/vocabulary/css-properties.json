{
  "$schema": "../schemas/css-vocabulary.schema.json",
  "$description": "The closed CSS vocabulary. A component may only use these properties. Values must be token references of an accepted token type, or one of the enumerated keywords. Growing the system means adding entries here (a deliberate, reviewable act), not writing literals in a component.",
  "states": ["hover", "focus-visible", "active", "disabled"],
  "properties": {
    "display": { "keywords": ["block", "inline", "inline-block", "flex", "inline-flex", "grid", "none"] },
    "flex-direction": { "keywords": ["row", "column"] },
    "flex-wrap": { "keywords": ["wrap", "nowrap"] },
    "align-items": { "keywords": ["flex-start", "center", "flex-end", "stretch", "baseline"] },
    "justify-content": { "keywords": ["flex-start", "center", "flex-end", "space-between", "space-around"] },
    "gap": { "token_types": ["dimension"], "multi": true },
    "padding": { "token_types": ["dimension"], "multi": true },
    "padding-block": { "token_types": ["dimension"], "multi": true },
    "padding-inline": { "token_types": ["dimension"], "multi": true },
    "margin": { "token_types": ["dimension"], "multi": true },
    "margin-block-end": { "token_types": ["dimension"] },
    "width": { "token_types": ["dimension"], "keywords": ["auto"] },
    "height": { "token_types": ["dimension"], "keywords": ["auto"] },
    "min-width": { "token_types": ["dimension"] },
    "min-height": { "token_types": ["dimension"] },
    "max-width": { "token_types": ["dimension"], "keywords": ["none"] },
    "background-color": { "token_types": ["color"], "keywords": ["transparent", "inherit"] },
    "color": { "token_types": ["color"], "keywords": ["inherit"] },
    "border-radius": { "token_types": ["dimension"], "multi": true },
    "border-width": { "token_types": ["dimension"], "multi": true },
    "border-style": { "keywords": ["solid", "dashed", "none"] },
    "border-color": { "token_types": ["color"], "keywords": ["transparent"] },
    "border-inline-start-width": { "token_types": ["dimension"] },
    "font-family": { "token_types": ["fontFamily"], "keywords": ["inherit"] },
    "font-size": { "token_types": ["dimension"], "keywords": ["inherit"] },
    "font-weight": { "token_types": ["fontWeight"], "keywords": ["inherit"] },
    "line-height": { "token_types": ["number"], "keywords": ["inherit"] },
    "letter-spacing": { "token_types": ["dimension"], "keywords": ["normal"] },
    "text-align": { "keywords": ["left", "center", "right"] },
    "text-decoration": { "keywords": ["none", "underline"] },
    "text-transform": { "keywords": ["none", "uppercase", "capitalize"] },
    "white-space": { "keywords": ["normal", "nowrap"] },
    "overflow": { "keywords": ["visible", "hidden"] },
    "cursor": { "keywords": ["auto", "default", "pointer", "not-allowed"] },
    "opacity": { "token_types": ["number"] },
    "transition-duration": { "token_types": ["duration"] },
    "transition-property": { "keywords": ["none", "all", "color", "background-color", "border-color", "opacity"] }
  }
}
